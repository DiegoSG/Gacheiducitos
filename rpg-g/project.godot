; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RPG_G"
run/main_scene="res://scenes/overworld/overworld.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/managers/game_manager.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
Inventory="*res://scripts/managers/inventory.gd"
ItemDatabase="*res://scripts/managers/item_database.gd"
PlayerStats="*res://scripts/managers/player_stats.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[internationalization]

locale/translations_pot_files=PackedStringArray("res://scenes/overworld/barnaby.dialogue", "res://scenes/overworld/chest.dialogue")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
